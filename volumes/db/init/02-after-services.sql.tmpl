-- ---------------------------------------------------------------------------
-- Runs *conceptually* after GoTrue and storage-api have created their own
-- tables (auth.users, storage.buckets, storage.objects).  Postgres's initdb
-- runs synchronously during first boot though — before those services have
-- had a chance to migrate — so we cannot simply sort this as `02-*.sql`.
--
-- The `supabase-bootstrap` one-shot service in docker-compose.supabase.yml
-- waits for the auth/storage migrations to land and then applies this file
-- via psql.  Re-run is idempotent (DROP IF EXISTS / ON CONFLICT DO NOTHING).
-- ---------------------------------------------------------------------------

-- ===========================================================================
-- Auto-create profile row whenever a new auth.users row appears.
-- ===========================================================================
CREATE OR REPLACE FUNCTION public.handle_new_user()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
  INSERT INTO public.profiles (id, display_name)
  VALUES (NEW.id, COALESCE(NEW.raw_user_meta_data->>'display_name', NEW.email))
  ON CONFLICT (id) DO NOTHING;
  RETURN NEW;
END$$;

DROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;
CREATE TRIGGER on_auth_user_created
  AFTER INSERT ON auth.users
  FOR EACH ROW EXECUTE FUNCTION public.handle_new_user();

-- ===========================================================================
-- Storage bucket `images` + per-object RLS mirroring public.images visibility
-- ===========================================================================
INSERT INTO storage.buckets (id, name, public)
VALUES ('images', 'images', false)
ON CONFLICT (id) DO NOTHING;

-- Read: allow when the corresponding public.images row is readable by caller.
DROP POLICY IF EXISTS "images object read" ON storage.objects;
CREATE POLICY "images object read"
  ON storage.objects FOR SELECT
  TO anon, authenticated
  USING (
    bucket_id = 'images'
    AND EXISTS (
      SELECT 1 FROM public.images
      WHERE storage_path = storage.objects.name
        AND (
          visibility = 'public'
          OR (visibility = 'lab'     AND auth.role() = 'authenticated')
          OR (visibility = 'private' AND owner_id  = auth.uid())
        )
    )
  );

-- Write: any authenticated user can upload into their own namespace
-- (<user_id>/...), and owner of the object can delete.
DROP POLICY IF EXISTS "images object insert" ON storage.objects;
CREATE POLICY "images object insert"
  ON storage.objects FOR INSERT
  TO authenticated
  WITH CHECK (
    bucket_id = 'images'
    AND (storage.foldername(name))[1] = auth.uid()::text
  );

DROP POLICY IF EXISTS "images object delete" ON storage.objects;
CREATE POLICY "images object delete"
  ON storage.objects FOR DELETE
  TO authenticated
  USING (
    bucket_id = 'images'
    AND owner = auth.uid()
  );

-- ===========================================================================
-- annotations (PR #4) — manual polygon labels for tissue classes.  Used as
-- training data for the deep-learning segmentation that arrives in PR #5.
--
-- Lives here (not in 01-schema.sql) so it lands on existing deployments too:
-- `/docker-entrypoint-initdb.d/01-schema.sql` only executes on first initdb
-- of a data volume, whereas this file is applied by supabase-bootstrap on
-- every `docker compose up`, and every statement below is idempotent.
--
-- NB: clients talk to PostgREST directly with the anon/JWT key, so DB-level
-- validation is the only thing stopping a malicious caller from writing an
-- unknown class or a malformed polygon that would crash the renderer (and
-- poison training data).  Keep in sync with frontend/lib/tissue-classes.ts
-- and backend/app/pipeline/classes.py.
-- ===========================================================================
CREATE OR REPLACE FUNCTION public.is_valid_polygon(p jsonb) RETURNS boolean
  LANGUAGE sql IMMUTABLE
AS $$
  SELECT p IS NOT NULL
     AND jsonb_typeof(p) = 'array'
     AND jsonb_array_length(p) >= 3
     AND NOT EXISTS (
       SELECT 1
       FROM jsonb_array_elements(p) AS elem
       WHERE jsonb_typeof(elem) <> 'array'
          OR jsonb_array_length(elem) <> 2
          OR jsonb_typeof(elem -> 0) <> 'number'
          OR jsonb_typeof(elem -> 1) <> 'number'
     )
$$;

CREATE TABLE IF NOT EXISTS public.annotations (
  id          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  image_id    uuid NOT NULL REFERENCES public.images(id)    ON DELETE CASCADE,
  owner_id    uuid NOT NULL REFERENCES public.profiles(id)  ON DELETE CASCADE,
  class       text NOT NULL,
  polygon     jsonb NOT NULL,
  note        text,
  created_at  timestamptz NOT NULL DEFAULT now(),
  updated_at  timestamptz NOT NULL DEFAULT now()
);

-- Add CHECK constraints defensively (ALTER TABLE … ADD CONSTRAINT doesn't
-- support IF NOT EXISTS before PG 18, so we drop+add to stay idempotent).
-- Keep the class list in sync with frontend/lib/tissue-classes.ts and
-- backend/app/pipeline/classes.py.
ALTER TABLE public.annotations DROP CONSTRAINT IF EXISTS annotations_class_check;
ALTER TABLE public.annotations ADD CONSTRAINT annotations_class_check CHECK (
  class IN (
    'upper_epidermis', 'lower_epidermis', 'palisade', 'spongy',
    'bundle_sheath', 'xylem', 'xylem_vessel', 'phloem', 'stomata',
    'intercellular', 'other'
  )
);
ALTER TABLE public.annotations DROP CONSTRAINT IF EXISTS annotations_polygon_check;
ALTER TABLE public.annotations ADD CONSTRAINT annotations_polygon_check CHECK (
  public.is_valid_polygon(polygon)
);

CREATE INDEX IF NOT EXISTS annotations_image_idx ON public.annotations(image_id);
CREATE INDEX IF NOT EXISTS annotations_owner_idx ON public.annotations(owner_id);

ALTER TABLE public.annotations ENABLE ROW LEVEL SECURITY;

-- Annotations are considered research IP and only surface to signed-in users
-- — `public`-visibility images themselves are readable anonymously, but we
-- don't expose the labels that have been manually traced on top of them.
DROP POLICY IF EXISTS "annotations read"        ON public.annotations;
CREATE POLICY "annotations read"
  ON public.annotations FOR SELECT
  TO authenticated
  USING (EXISTS (SELECT 1 FROM public.images WHERE id = annotations.image_id));

DROP POLICY IF EXISTS "annotations insert"      ON public.annotations;
CREATE POLICY "annotations insert"
  ON public.annotations FOR INSERT
  TO authenticated
  WITH CHECK (
    owner_id = auth.uid()
    AND EXISTS (SELECT 1 FROM public.images WHERE id = annotations.image_id)
  );

DROP POLICY IF EXISTS "annotations owner update" ON public.annotations;
CREATE POLICY "annotations owner update"
  ON public.annotations FOR UPDATE
  TO authenticated
  USING (
    owner_id = auth.uid()
    AND EXISTS (SELECT 1 FROM public.images WHERE id = annotations.image_id)
  )
  WITH CHECK (
    owner_id = auth.uid()
    AND EXISTS (SELECT 1 FROM public.images WHERE id = annotations.image_id)
  );

DROP POLICY IF EXISTS "annotations owner delete" ON public.annotations;
CREATE POLICY "annotations owner delete"
  ON public.annotations FOR DELETE
  TO authenticated
  USING (owner_id = auth.uid());

DROP TRIGGER IF EXISTS annotations_set_updated_at ON public.annotations;
CREATE TRIGGER annotations_set_updated_at
  BEFORE UPDATE ON public.annotations
  FOR EACH ROW EXECUTE FUNCTION public.set_updated_at();

-- ===========================================================================
-- images metadata (PR #8) — add columns for per-plant study groupings.
--
-- Lives here (not in 01-schema.sql) so existing deployments pick up the new
-- columns on `docker compose up`.  `ADD COLUMN IF NOT EXISTS` is idempotent
-- from PG 9.6 onwards.
-- ===========================================================================
ALTER TABLE public.images ADD COLUMN IF NOT EXISTS species            text;
ALTER TABLE public.images ADD COLUMN IF NOT EXISTS photosynthesis_type text;
ALTER TABLE public.images ADD COLUMN IF NOT EXISTS plant_id           text;
ALTER TABLE public.images ADD COLUMN IF NOT EXISTS treatment          text;
ALTER TABLE public.images ADD COLUMN IF NOT EXISTS captured_at        timestamptz;

-- Restrict photosynthesis_type to known values (null allowed so legacy rows
-- don't break).  Drop + re-add for PG < 18 that lacks IF NOT EXISTS.
ALTER TABLE public.images DROP CONSTRAINT IF EXISTS images_photosynthesis_type_check;
ALTER TABLE public.images ADD CONSTRAINT images_photosynthesis_type_check CHECK (
  photosynthesis_type IS NULL OR photosynthesis_type IN ('C3', 'C4', 'CAM', 'unknown')
);

CREATE INDEX IF NOT EXISTS images_species_idx              ON public.images(species);
CREATE INDEX IF NOT EXISTS images_photosynthesis_type_idx  ON public.images(photosynthesis_type);
CREATE INDEX IF NOT EXISTS images_plant_id_idx             ON public.images(plant_id);
CREATE INDEX IF NOT EXISTS images_treatment_idx            ON public.images(treatment);

-- ===========================================================================
-- batch_runs (PR #8) — groups a fan-out of analyses so Phase B (automated
-- reports) and Phase C (comparison dashboard) can consume the same structure.
-- ===========================================================================
CREATE TABLE IF NOT EXISTS public.batch_runs (
  id              uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  owner_id        uuid NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
  label           text,                                   -- optional human label
  criteria        jsonb NOT NULL DEFAULT '{}'::jsonb,     -- e.g. {"species":"Z.mays"}
  pipeline_kinds  text[] NOT NULL,                        -- e.g. ['basic_measurement','segformer_tissue']
  image_ids       uuid[] NOT NULL,
  analysis_ids    uuid[] NOT NULL DEFAULT ARRAY[]::uuid[],
  status          text NOT NULL DEFAULT 'pending'
                  CHECK (status IN ('pending', 'running', 'done', 'partial', 'error')),
  total           integer NOT NULL DEFAULT 0,
  succeeded       integer NOT NULL DEFAULT 0,
  failed          integer NOT NULL DEFAULT 0,
  error           text,
  created_at      timestamptz NOT NULL DEFAULT now(),
  updated_at      timestamptz NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS batch_runs_owner_idx       ON public.batch_runs(owner_id);
CREATE INDEX IF NOT EXISTS batch_runs_status_idx      ON public.batch_runs(status);
CREATE INDEX IF NOT EXISTS batch_runs_created_at_idx  ON public.batch_runs(created_at DESC);

ALTER TABLE public.batch_runs ENABLE ROW LEVEL SECURITY;

-- Owner-only for read/write.  Batches carry a snapshot of which images
-- were selected, so cross-user sharing would need its own visibility
-- column; for PR #8 we stay simple.
DROP POLICY IF EXISTS "batch_runs owner read" ON public.batch_runs;
CREATE POLICY "batch_runs owner read"
  ON public.batch_runs FOR SELECT
  TO authenticated
  USING (owner_id = auth.uid());

DROP POLICY IF EXISTS "batch_runs owner write" ON public.batch_runs;
CREATE POLICY "batch_runs owner write"
  ON public.batch_runs FOR ALL
  TO authenticated
  USING (owner_id = auth.uid())
  WITH CHECK (owner_id = auth.uid());

DROP TRIGGER IF EXISTS batch_runs_set_updated_at ON public.batch_runs;
CREATE TRIGGER batch_runs_set_updated_at
  BEFORE UPDATE ON public.batch_runs
  FOR EACH ROW EXECUTE FUNCTION public.set_updated_at();
