# ==============================================================================
# tools_for_plants_research — environment variables
# Copy this file to `.env` and fill in real values before `docker compose up`.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase: Postgres
# ------------------------------------------------------------------------------
POSTGRES_HOST=supabase-db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password

# ------------------------------------------------------------------------------
# Supabase: JWT
# Generate with: openssl rand -base64 48
# Then derive anon/service keys via Supabase's JWT generator or the supplied
# helper script (see README).
# ------------------------------------------------------------------------------
JWT_SECRET=replace-with-at-least-32-chars-random-string-xxxxxxxx
JWT_EXPIRY=3600
ANON_KEY=replace-with-anon-jwt
SERVICE_ROLE_KEY=replace-with-service-role-jwt

# ------------------------------------------------------------------------------
# Supabase: public URLs
# SUPABASE_PUBLIC_URL is what the browser hits (Kong gateway).
# SUPABASE_INTERNAL_URL is used by backend containers on the compose network.
# ------------------------------------------------------------------------------
SUPABASE_PUBLIC_URL=http://localhost:8000
SUPABASE_INTERNAL_URL=http://supabase-kong:8000

# ------------------------------------------------------------------------------
# Supabase: Auth (GoTrue)
# ------------------------------------------------------------------------------
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

# SMTP — leave blank to skip real email in dev (magic links surface in logs)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_SENDER_NAME=plants-research

# ------------------------------------------------------------------------------
# Supabase: Storage
# ------------------------------------------------------------------------------
STORAGE_BACKEND=file
FILE_SIZE_LIMIT=104857600   # 100 MB per image

# ------------------------------------------------------------------------------
# Supabase: Studio (admin UI)
# ------------------------------------------------------------------------------
STUDIO_DEFAULT_ORGANIZATION=plants-research
STUDIO_DEFAULT_PROJECT=plants-research
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=replace-me

# ------------------------------------------------------------------------------
# Our backend (FastAPI)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
BACKEND_LOG_LEVEL=info
BACKEND_CORS_ORIGINS=http://localhost:3000

# Backend talks to Supabase via the internal URL on the compose network.
# ANON_KEY/SERVICE_ROLE_KEY above are reused.

# ------------------------------------------------------------------------------
# Our frontend (Next.js)
# NEXT_PUBLIC_* is baked into the browser bundle and therefore points at the
# host-exposed Kong port.  SUPABASE_URL (no NEXT_PUBLIC_ prefix) is read only
# on the server and must reach Kong across the compose network.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-jwt
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_URL=http://supabase-kong:8000
